# Bu dosyayı .env adıyla kopyalayıp kendi değerlerinizi girin:
#   cp .env.example .env
TELEGRAM_BOT_TOKEN=1234567890:AAH...
TELEGRAM_CHAT_ID=123456789
# FAVORİ LİSTELERİ tarama aralığı (--loop modu). Her turda MIN-MAX
# dakika arası rastgele bir bekleme seçilir (küsuratlı: 4.7 dk gibi).
# MAX boş bırakılırsa sabit MIN dakika kullanılır.
CHECK_INTERVAL_MIN=5
CHECK_INTERVAL_MAX=5

# TEKİL ÜRÜNLER tarama aralığı. Tanımlıysa tekil ürünler listelerden
# BAĞIMSIZ ve daha sık taranır (Zara tekil ürünleri 10'arlı tek istekte
# sorgulandığı için bu çok az ek yük getirir). Boş bırakılırsa eski
# davranış: her şey tek turda, CHECK_INTERVAL aralığıyla taranır.
PRODUCT_INTERVAL_MIN=1
PRODUCT_INTERVAL_MAX=1

# Sadece Pi/kendi sunucunuzda çalıştırıyorsanız ve panelin (GitHub Pages)
# canlı kalmasını istiyorsanız doldurun. Boş bırakılırsa state.json/
# watchlist.json sadece yerel diskte kalır, GitHub'a push edilmez.
GITHUB_PUSH_TOKEN=

# Push sıklığı: anlamlı bir değişiklik (stok, ürün/liste ekleme-silme)
# olduğunda HER ZAMAN hemen push edilir. Değişiklik yoksa panelin "son
# kontrol" saati donmasın diye bu aralıkta bir kez "nabız" push'u atılır.
GIT_PUSH_HEARTBEAT_MIN=20

# Raspberry Pi gibi cihazlarda CPU sıcaklığı güvenlik eşikleri (°C).
# TEMP_WARN_C aşılınca bir kez Telegram uyarısı; TEMP_PAUSE_C aşılınca
# o turda stok kontrolü tamamen atlanır (Pi değilse bu ayarların hiç
# etkisi yoktur — sıcaklık okunamadığı için her zaman güvenli sayılır).
TEMP_WARN_C=75
TEMP_PAUSE_C=80
